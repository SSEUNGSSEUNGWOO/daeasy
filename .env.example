# dataeasy 환경변수 참고 (source of truth)
# - frontend 는 frontend/.env.local, ai-service 는 ai-service/.env 에 각각 채운다
# - ai-service/insights/run.py 는 루트 .env 를 먼저 로드한 뒤 ai-service/.env 로 보완한다

# ===== frontend (frontend/.env.local) =====
# Studio → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 운영 사이트 기준 URL. 인증 이메일의 복귀 주소에 사용 (예: https://dataeasy.kr)
NEXT_PUBLIC_SITE_URL=
# service_role — 서버 전용. Vercel 에서는 Sensitive 체크
SUPABASE_SERVICE_ROLE_KEY=

# AI 체험관(/quiz)은 런타임에 모델을 부르지 않는다 — 선택지 응답을 미리 생성해
# public/experience/*.json 으로 두고 클라이언트가 재생한다. Vercel 에는 이 키가 필요 없다.
#
# 아래는 응답을 다시 생성할 때만 쓰는 로컬 전용 키다 (frontend/scripts/gen-canned.mjs).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 어드민(/admin) 로그인은 Supabase Auth 계정을 쓴다. 별도 환경변수 없음.
# 첫 관리자 계정은 Studio 에서 만들고 public.profiles 에 role='admin' 행을 넣는다.
# 이후 계정은 관리자가 /admin/members 에서 발급한다.

# (선택) Upstash Redis rate limiter. 없으면 rate limit 자동 비활성
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 일반 고객 회원가입 CAPTCHA (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ===== ai-service (ai-service/.env) =====
# psycopg2 direct connection — 반드시 Session pooler URL 을 쓴다.
# Studio → Project Settings → Database → Connection string → Session pooler
# (db.<ref>.supabase.co 형태의 direct URL 은 IPv6 전용이라 일반 환경에서 해석 실패)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# ai-service/scripts 의 supabase-py upsert 용 (교육과정 · 교육후기 스크래핑)
SUPABASE_URL=https://<project-ref>.supabase.co

# claude CLI 는 Anthropic Max 구독을 소비한다 — 의도적으로 비워둔다 (API 크레딧 사용 방지)
ANTHROPIC_API_KEY=

# 인사이트 커버 이미지 (Unsplash)
UNSPLASH_ACCESS_KEY=
