# dataeasy 통합 환경변수 (.env에 복사 후 채우기)
# - ai-service의 run.py가 ROOT/.env를 우선 로드한다
# - backend / frontend는 각자 폴더의 .env(.local)에서 읽는 게 권장이지만, 이 파일을 source of truth로 참고

# ----- Supabase -----
# Studio → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ai-service psycopg2 direct connection
# Studio → Project Settings → Database → Connection string → URI (Session pooler 또는 direct)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ----- claude CLI -----
# 의도적으로 비워둠 — Anthropic Max 구독을 소비하기 위함 (API 크레딧 사용 방지)
ANTHROPIC_API_KEY=

# ----- AI 서비스 외부 API -----
# 인사이트 커버 이미지 (Unsplash)
UNSPLASH_ACCESS_KEY=

# 가이드 자동 이미지 생성 (DALL-E 3)
OPENAI_API_KEY=

# ----- 뉴스레터 (Resend) -----
RESEND_API_KEY=
NEWSLETTER_FROM=dataeasy <newsletter@dataeasy.kr>

# ----- 사이트 URL -----
SITE_URL=https://dataeasy.kr
NEXT_PUBLIC_SITE_URL=https://dataeasy.kr
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
